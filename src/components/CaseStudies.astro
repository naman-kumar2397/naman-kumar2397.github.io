---
import { caseStudies } from '../data/caseStudies';
import Flow from './Flow.astro';
import { projects } from '../data/profile';
const sideProjects = projects.filter((p) => p.home);

const sections = [
  ['problem', 'Problem'],
  ['decisions', 'Engineering decisions'],
  ['implementation', 'Implementation'],
  ['reliability', 'Reliability and security'],
  ['outcomes', 'Outcomes'],
  ['lessons', 'Lessons learned'],
] as const;
// Flagships (with their own page) first.
const ordered = [...caseStudies].sort((a, b) => Number(!!b.feature) - Number(!!a.feature));
// Same-named view-transition groups on the home page and project page, tuned for the title morph.
const vtCss = caseStudies
  .filter((c) => c.feature)
  .map((c) => `::view-transition-group(cs-title-${c.id}){animation-duration:var(--dur-slow);animation-timing-function:var(--ease-out);}`)
  .join('');
import { branches, type Branch } from '../data/journey';
const branchName = (id: string) => (branches as Record<string, Branch>)[id]?.name ?? id;
---
<section id="projects" class="container section" aria-labelledby="projects-title">
  <div class="section-head" data-reveal="heading">
    <p class="kicker">ls projects/</p>
    <h2 id="projects-title">Engineering case studies</h2>
    <p>Three flagship projects with full write-ups, plus current work in progress and a side project. Client-specific details are intentionally left out.</p>
  </div>
  <ul class="cases" data-reveal-group>
    {ordered.map((c) => (
      <li class={c.feature ? 'case featured' : 'case'}>
        <article aria-labelledby={`cs-${c.id}`} data-reveal={c.feature ? 'cinematic' : 'card'} data-pointer data-tilt={c.feature ? '2' : undefined}>
          <div class="c-top">
            <span class={`state ${c.status === 'Shipped' ? 'merged' : 'open'}`}>{c.status}</span>
            <span class="ctx">{c.context}</span>
          </div>
          <h3 id={`cs-${c.id}`} style={c.feature ? `view-transition-name:cs-title-${c.id}` : undefined}>{c.title}</h3>
          <p class="headline">{c.headline}</p>
          <p class="overview">{c.overview}</p>
          {c.feature ? (
            <p class="read"><a class="btn btn-lg" href={`/projects/${c.id}/`}>Read the case study<span class="arrow" aria-hidden="true">→</span><span class="sr-only">: {c.title}</span></a></p>
          ) : (
            <>
              {c.architecture && (
                <div class="arch" style={`--steps:${c.architecture.steps.length}`}>
                  <h4 class="sub">Architecture</h4>
                  <Flow steps={c.architecture.steps} caption={c.architecture.caption} label={`${c.title}: architecture, step by step`} />
                </div>
              )}
              <details class="deep">
                <summary>More detail</summary>
                <div class="deep-in">
                  {sections.map(([key, title]) => {
                    const v = c[key];
                    if (!v || (Array.isArray(v) && v.length === 0)) return null;
                    return (
                      <section>
                        <h4 class="sub">{title}</h4>
                        {typeof v === 'string' ? <p>{v}</p> : <ul>{v.map((x) => <li>{x}</li>)}</ul>}
                      </section>
                    );
                  })}
                </div>
              </details>
            </>
          )}
          <div class="c-foot">
            <ul class="stack" aria-label="Technologies">{c.stack.map((t) => <li class="topic">{t}</li>)}</ul>
            {c.branch && <a class="to-log mono" href={`?branch=${c.branch}#journey`} data-branch={c.branch}><span class="u">git log {branchName(c.branch)}</span></a>}
          </div>
        </article>
      </li>
    ))}
  </ul>
  {sideProjects.length > 0 && (
    <div class="side" data-reveal="card">
      <h3 class="side-title mono">Side projects</h3>
      <ul class="side-list">
        {sideProjects.map((p) => (
          <li class="side-item">
            <h4>{p.name}</h4>
            <p class="overview">{p.text}</p>
            {p.links && <p class="side-links">{p.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>}
            {p.note && <p class="note">{p.note}</p>}
            {p.stack && <ul class="stack" aria-label="Technologies">{p.stack.map((t) => <li class="topic">{t}</li>)}</ul>}
          </li>
        ))}
      </ul>
    </div>
  )}
</section>
<style is:inline set:html={vtCss}></style>

<style>
  .side { margin-top: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); padding: 16px; }
  .side-title { margin: 0 0 10px; font-size: 12px; font-weight: 400; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .side-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .side-item h4 { margin: 0; font-size: 16px; }
  .side-item .overview { margin: 4px 0 0; }
  .side-links { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 8px 0 0; font-size: 14px; }
  .side-links a { display: inline-flex; align-items: center; min-height: 24px; }
  .note { margin: 6px 0 0; font-size: 12px; color: var(--muted); }
  .side-item .stack { margin-top: 10px; }
  @media (min-width: 900px) { .side { padding: 20px 24px; } }
  .cases { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 900px) {
    .cases { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .case:not(.featured) { grid-column: 1 / -1; }
    .featured article { display: flex; flex-direction: column; height: 100%; }
    .featured .c-foot { margin-top: auto; }
  }
  .read { margin: 14px 0 12px; } /* bottom margin keeps the button off the divider when the card is the tallest */
  .read .btn { color: var(--accent); }
  .read .arrow { display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
  .read .btn:hover .arrow, .read .btn:focus-visible .arrow { transform: translateX(3px); }
  article {
    container: case / inline-size; position: relative; isolation: isolate;
    border: 1px solid var(--border); border-radius: 8px; padding: 16px; background: var(--bg); box-shadow: var(--shadow);
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-standard),
      border-color var(--dur-normal) var(--ease-standard);
  }
  /* Keep the reveal transitions (global) alongside the hover ones. */
  :global(html.motion) article[data-reveal] {
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      translate var(--dur-reveal) var(--ease-out),
      scale var(--dur-reveal) var(--ease-out),
      filter var(--dur-reveal) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-standard),
      border-color var(--dur-normal) var(--ease-standard);
  }
  article::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none; opacity: 0;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%);
    transition: opacity var(--dur-normal) var(--ease-standard);
  }
  @media (hover: hover) and (pointer: fine) {
    article:hover {
      border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
      box-shadow: var(--shadow), 0 14px 32px -14px rgba(1, 4, 9, .28);
    }
    article:hover::before { opacity: 1; }
    @media (prefers-reduced-motion: no-preference) {
      .featured article:hover {
        transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
        transition-duration: var(--dur-normal), var(--dur-normal), var(--dur-normal);
      }
      :global(html.motion) .featured article[data-reveal]:hover {
        transition:
          opacity var(--dur-reveal) var(--ease-out),
          translate var(--dur-reveal) var(--ease-out),
          scale var(--dur-reveal) var(--ease-out),
          filter var(--dur-reveal) var(--ease-out),
          transform var(--dur-fast) var(--ease-out),
          box-shadow var(--dur-normal) var(--ease-standard),
          border-color var(--dur-normal) var(--ease-standard);
      }
    }
  }
  .c-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .ctx { font-size: 13px; color: var(--muted); }
  h3 { font-size: 20px; line-height: 1.3; margin: 10px 0 0; font-weight: 600; letter-spacing: -0.01em; }
  .headline { margin: 4px 0 0; font-weight: 600; color: var(--accent); }
  .overview { margin: 8px 0 0; max-width: 75ch; }
  .sub { font: 600 12px/1.5 var(--mono); text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin: 0 0 8px; }
  .arch { margin-top: 16px; }
  .deep { margin-top: 12px; border-top: 1px solid var(--border-muted); }
  .deep summary { display: flex; align-items: center; min-height: 44px; color: var(--accent); font-weight: 500; }
  .deep-in { display: grid; gap: 16px; padding: 4px 0 4px; }
  .deep-in p { margin: 0; max-width: 75ch; }
  .deep-in ul { margin: 0; padding-left: 20px; }
  .deep-in li { margin: 4px 0; }
  .c-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-muted); }
  .to-log { font-size: 12px; display: inline-flex; align-items: center; min-height: 32px; }
  .to-log:hover { text-decoration: none; }
  .to-log .u {
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 40%, transparent)) no-repeat 0 100% / 0 1px;
    padding-bottom: 1px;
    transition: background-size var(--dur-normal) var(--ease-out);
  }
  .to-log:hover .u, .to-log:focus-visible .u { background-size: 100% 1px; }
  @media (min-width: 768px) {
    article { padding: 20px 24px; }
    @container case (min-width: 760px) { .deep-in { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 32px; } }
  }
</style>
