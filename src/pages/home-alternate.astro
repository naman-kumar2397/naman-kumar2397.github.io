---
/*
 * /home-alternate/: the journey homepage, built alongside the live one. The hero gives the
 * key facts in five seconds; the journey is a guided ride through six chapters (newest first)
 * with one morphing particle field; then the toolbox and the exit. Native scroll only.
 * While it is the alternate it is noindex with its canonical on /, and it is not in the
 * sitemap or llms.txt (both are data-driven and do not list it).
 */
import Base from '../layouts/Base.astro';
import RepoHeader from '../components/RepoHeader.astro';
import RideHero from '../components/ride/RideHero.astro';
import Journey from '../components/ride/Journey.astro';
import Toolbox from '../components/ride/Toolbox.astro';
import Exit from '../components/ride/Exit.astro';
import { commits } from '../data/journey';
import { caseStudies } from '../data/caseStudies';
import { chapters } from '../lib/ride';
import { profileJsonLd } from '../lib/jsonld';

const site = Astro.site!.toString();
const jsonLd = await profileJsonLd(site);
const tabs = [
  { href: '#top', label: 'Overview' },
  { href: '#journey', label: 'Journey', count: chapters.length },
  { href: '#toolbox', label: 'Toolbox' },
  { href: '#contact', label: 'Contact' },
];
---
<Base
  title="Naman Kumar | Lead SRE, Melbourne: the journey"
  description="Naman Kumar, Lead SRE in Melbourne: the career journey from HEAD back to main, with the key facts, the case studies and the toolbox."
  noindex
  canonical={site}
  jsonLd={jsonLd}
>
  <a class="skip" href="#main">Skip to content</a>
  <RepoHeader commitCount={commits.length} projectCount={caseStudies.length} tabs={tabs} />
  <main id="main">
    <RideHero />
    <Journey />
    <Toolbox />
    <Exit />
  </main>
  <footer class="container foot">
    <p><span class="mono">HEAD</span> is where I am now. Built with Astro. Cookie-free, privacy-friendly visit counts (GoatCounter).</p>
    <p><a href="#top">Back to top</a></p>
  </footer>
</Base>

<style>
  .skip { position: absolute; left: 8px; top: -48px; z-index: 30; background: var(--bg); padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; }
  .skip:focus { top: 8px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-top: 40px; padding-bottom: 40px; font-size: 13px; color: var(--muted); }
  .foot p { margin: 0; }
</style>
