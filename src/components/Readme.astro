---
import { profile } from '../data/profile';
---
<aside class="box readme" aria-labelledby="readme-name">
  <div class="box-head"><span class="mono">README.md</span></div>
  <div class="md">
    <div class="who">
      <img class="avatar" src="/profile.jpg" alt="" width="64" height="64" decoding="async" />
      <div>
        <h1 id="readme-name">{profile.name}</h1>
        <p class="muted role">{profile.role} · {profile.location}</p>
      </div>
    </div>
    <p>{profile.intro}</p>
    <ul class="stats">
      {profile.stats.map((s) => <li class="stat"><b>{s.value}</b><span>{s.label}</span></li>)}
    </ul>
    <h2>Topics</h2>
    <ul class="topics">{profile.topics.map((t) => <li class="topic">{t}</li>)}</ul>
    <h2>Explore</h2>
    <p class="muted">Each company is a branch off <code>main</code>. Select any commit in the log to expand it.</p>
    <div class="links">
      <a class="btn" href="/resume.pdf" download>Download resume</a>
      <a class="btn" href={`mailto:${profile.email}`}>Email</a>
      <a class="btn" href={profile.linkedin} rel="noopener">LinkedIn</a>
    </div>
  </div>
</aside>

<style>
  .md { padding: 16px; }
  .who { display: flex; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-muted); }
  .avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); flex: none; }
  h1 { font-size: 22px; line-height: 1.25; margin: 0; font-weight: 600; }
  .role { margin: 2px 0 0; }
  h2 { font-size: 14px; margin: 20px 0 6px; color: var(--muted); font-weight: 600; }
  p { margin: 12px 0 0; }
  code { font: 12px var(--mono); background: var(--code-bg); border: 1px solid var(--border-muted); border-radius: 6px; padding: 1px 5px; }
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 16px 0 0; padding: 0; list-style: none; }
  .stat { border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; background: var(--panel); }
  .stat b { display: block; font-size: 20px; line-height: 1.3; font-weight: 600; }
  .stat span { font-size: 12px; color: var(--muted); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  @media (min-width: 640px) { .md { padding: 20px 24px; } .avatar { width: 64px; height: 64px; } h1 { font-size: 24px; } }
</style>
