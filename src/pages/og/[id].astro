---
/* 1200x630 social card per flagship case study. `npm run assets` renders these to public/social/<id>.png. */
import { caseStudies } from '../../data/caseStudies';
import { profile } from '../../data/profile';

export function getStaticPaths() {
  return caseStudies.filter((c) => c.feature).map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>OG card: {c.title}</title></head>
  <body>
    <main class="card">
      <svg class="graph" width="120" height="630" viewBox="0 0 120 630" aria-hidden="true">
        <path d="M40 0V630" stroke="#8b949e" stroke-width="4" fill="none" />
        <path d="M40 470C40 420 80 430 80 380V160C80 110 40 120 40 70" stroke="#4493f8" stroke-width="4" fill="none" />
        <circle cx="80" cy="270" r="10" fill="#4493f8" /><circle cx="40" cy="70" r="9" fill="#0d1117" stroke="#4493f8" stroke-width="4" />
      </svg>
      <div class="copy">
        <p class="kicker">Case study · {c.context}</p>
        <h1>{c.title}</h1>
        <p class="headline">{c.headline}</p>
        <p class="by">{profile.name} · {profile.role}</p>
      </div>
    </main>
  </body>
</html>
<style is:global>
  body { margin: 0; }
  .card { width: 1200px; height: 630px; display: flex; gap: 40px; background: #0d1117; color: #f0f6fc; font-family: -apple-system, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif; padding: 0 80px 0 32px; box-sizing: border-box; align-items: center; }
  .graph { flex: none; align-self: stretch; height: 630px; }
  .kicker { margin: 0; font: 500 22px/1.4 ui-monospace, Menlo, monospace; color: #9198a1; }
  h1 { font-size: 68px; line-height: 1.05; margin: 18px 0 0; letter-spacing: -1.5px; max-width: 960px; }
  .headline { font-size: 32px; line-height: 1.3; color: #4493f8; margin: 22px 0 0; font-weight: 600; max-width: 960px; }
  .by { font-size: 24px; color: #9198a1; margin: 40px 0 0; }
</style>
