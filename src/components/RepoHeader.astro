---
import { profile } from '../data/profile';

interface Props {
  commitCount: number;
  projectCount: number;
  /** Extra breadcrumb segments on sub-pages, e.g. ['projects', 'alfred']. */
  path?: string[];
  /** Tab to mark current on sub-pages. */
  current?: string;
}
const { commitCount, projectCount, path = [], current } = Astro.props;
const onHome = path.length === 0;
const base = onHome ? '' : '/';
const tabs = [
  { href: `${base}#top`, label: 'Overview' },
  { href: `${base}#experience`, label: 'Experience' },
  { href: `${base}#projects`, label: 'Projects', count: projectCount },
  { href: `${base}#skills`, label: 'Skills' },
  { href: `${base}#journey`, label: 'Journey', count: commitCount },
  { href: `${base}#contact`, label: 'Contact' },
];
const isCurrent = (label: string, i: number) => (onHome ? i === 0 : label === current);
---
<header class="topbar">
  <div class="container topbar-in">
    <a class="home" href={onHome ? '#top' : '/'}>
      <span class="mark" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="4" cy="3" r="1.6" /><circle cx="4" cy="13" r="1.6" /><circle cx="12" cy="5" r="1.6" />
          <path d="M4 4.6v6.8M12 6.6c0 3-8 2-8 5" />
        </svg>
      </span>
      <span class="crumb"><span class="owner">naman-kumar</span> <span class="slash">/</span> {onHome ? <b>journey</b> : <span class="owner">journey</span>}{path.map((seg, i) => <> <span class="slash">/</span> {i === path.length - 1 ? <b>{seg}</b> : <span class="owner">{seg}</span>}</>)}</span>
    </a>
    <span class="pill">Public</span>
    <span class="sp"></span>
    <nav class="actions" aria-label="Quick links">
      <a class="btn" href="/resume.pdf" download="Naman_Kumar_Resume.pdf">Resume (PDF)</a>
      <a class="btn" href={profile.linkedin} rel="noopener">LinkedIn</a>
    </nav>
  </div>
</header>
<nav class="tabs" aria-label="Sections">
  <div class="container tabs-in">
    {tabs.map((t, i) => (
      <a class="tab" href={t.href} aria-current={isCurrent(t.label, i) ? (onHome ? 'true' : 'page') : undefined}>
        {t.label}{t.count !== undefined && <span class="count"><span class="sr-only">(</span>{t.count}<span class="sr-only"> items)</span></span>}
      </a>
    ))}
  </div>
</nav>

<style>
  .topbar { background: var(--panel); }
  .topbar-in { display: flex; align-items: center; gap: 12px; padding-top: 14px; padding-bottom: 6px; }
  .home { display: flex; align-items: center; gap: 10px; color: var(--text); min-width: 0; }
  .home:hover { text-decoration: none; }
  .home:hover b { text-decoration: underline; }
  .mark { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--border); display: grid; place-items: center; color: var(--muted); background: var(--bg); flex: none; }
  .crumb { font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .owner { color: var(--text); }
  .slash { color: var(--muted); }
  .crumb b { font-weight: 600; }
  .pill { font-size: 12px; font-weight: 500; line-height: 18px; border: 1px solid var(--border); border-radius: 2em; padding: 0 7px; color: var(--muted); flex: none; }
  .sp { flex: 1; }
  .actions { display: none; gap: 8px; }

  .tabs {
    position: sticky; top: 0; z-index: 20;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
  }
  .tabs-in { position: relative; display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; }
  .tabs-in::-webkit-scrollbar { display: none; }
  .tab {
    display: inline-flex; align-items: center; gap: 6px;
    min-height: 48px; padding: 0 10px;
    color: var(--text); white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .tab:hover { text-decoration: none; border-bottom-color: var(--border); }
  .tab[aria-current] { font-weight: 600; border-bottom-color: var(--tab-active); }
  .count { background: var(--border-muted); border-radius: 2em; padding: 0 6px; font-size: 12px; font-weight: 500; line-height: 18px; }
  @media (min-width: 640px) { .actions { display: flex; } }
</style>

<script>
  // Scroll-spy only on the home page (tab links there are in-page hashes).
  const tabs = location.pathname === '/' ? [...document.querySelectorAll<HTMLAnchorElement>('.tabs .tab')] : [];
  const sections = tabs
    .map((t) => document.getElementById(t.hash.slice(1)))
    .filter((s): s is HTMLElement => !!s);
  const setActive = (id: string) =>
    tabs.forEach((t) => {
      const on = t.hash === `#${id}`;
      if (on) {
        t.setAttribute('aria-current', 'true');
        // Keep the active tab visible in the horizontally scrolling bar (no vertical scroll).
        const bar = t.parentElement!;
        if (t.offsetLeft < bar.scrollLeft || t.offsetLeft + t.offsetWidth > bar.scrollLeft + bar.clientWidth)
          bar.scrollLeft = t.offsetLeft - 16;
      } else t.removeAttribute('aria-current');
    });
  // The section crossing a line ~30% down the viewport is the active one.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
    },
    { rootMargin: '-30% 0px -69% 0px' },
  );
  sections.forEach((s) => io.observe(s));
</script>
