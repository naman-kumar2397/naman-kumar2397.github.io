---
/* Print-first resume. `npm run resume:pdf` renders this page to public/resume.pdf. */
import { GOATCOUNTER } from '../lib/analytics';
import { accolades, certification, education, experience, profile, projects, resumeSkills as skills } from '../data/profile';

const resumeDescription = `Resume of ${profile.name}, Lead SRE in Melbourne: 7+ years of SRE on AWS, observability, infrastructure as code and incident automation.`;

// Same wording as the resume: "Viable Solutions (via Synechron, for Latitude Financial Services)".
const orgLine = (r: (typeof experience)[number]) => {
  const extra = [r.via && `via ${r.via}`, r.client && `for ${r.client}`].filter(Boolean).join(', ');
  return extra ? `${r.employer} (${extra})` : r.employer;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Naman Kumar | Resume: Lead Site Reliability Engineer, Melbourne</title>
    <meta name="description" content={resumeDescription} />
    <meta property="og:description" content={resumeDescription} />
    <link rel="canonical" href={new URL('/resume/', Astro.site)} />
    <link rel="alternate" type="text/markdown" href={new URL('/resume.md', Astro.site)} title="Markdown version" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Naman Kumar | Resume" />
    <meta property="og:url" content={new URL('/resume/', Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline async data-goatcounter={GOATCOUNTER} src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <main>
      <header>
        <h1>{profile.name}</h1>
        <p class="sub"><b>{profile.role}</b> · {profile.location}</p>
        <p class="contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>{' · '}
          <a href={profile.linkedin}>{profile.linkedinLabel}</a>{' · '}
          <a href="https://naman-kumar2397.github.io">naman-kumar2397.github.io</a>
        </p>
      </header>

      <section><h2>Summary</h2><p>{profile.summary}</p></section>

      <section>
        <h2>Skills</h2>
        <ul class="skills">
          {skills.map((g) => <li><b>{g.group}:</b> {g.items.join(', ')}</li>)}
        </ul>
      </section>

      <section>
        <h2>Work Experience</h2>
        {experience.map((r) => (
          <article>
            <div class="role"><h3>{r.title}</h3><span class="period">{r.period}</span></div>
            <p class="org">{orgLine(r)}{r.terms && ` | ${r.terms}`}</p>
            <ul>{r.points.map((p) => <li>{p.label && <b>{p.label}: </b>}{p.text}</li>)}</ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Projects</h2>
        <ul class="plain">{projects.map((p) => <li><b>{p.name}:</b> {p.text}</li>)}</ul>
      </section>

      <section>
        <h2>Accolades (Cvent)</h2>
        <ul>{accolades.map((a) => <li>{a}</li>)}</ul>
      </section>

      <section class="two">
        <div><h2>Education</h2><p>{education}</p></div>
        <div><h2>Certifications</h2><p>{certification}</p></div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 11mm 13mm; }
  * { box-sizing: border-box; }
  body { margin: 0; color: #1f2328; background: #fff; font: 9.5pt/1.35 -apple-system, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif; }
  main { max-width: 820px; margin: 0 auto; padding: 24px 16px; }
  @media print { main { padding: 0; max-width: none; } }
  a { color: #0969da; text-decoration: none; }
  h1 { font-size: 20pt; margin: 0; line-height: 1.2; }
  .sub { margin: 2px 0 0; font-size: 11pt; }
  .contact { margin: 4px 0 0; color: #59636e; overflow-wrap: anywhere; }
  h2 { font-size: 10.5pt; text-transform: uppercase; letter-spacing: .04em; color: #0969da; margin: 11px 0 5px; padding-bottom: 2px; border-bottom: 1px solid #d1d9e0; }
  h3 { font-size: 10.5pt; margin: 0; }
  p { margin: 0; }
  ul { margin: 4px 0 0; padding-left: 16px; }
  li { margin: 1px 0; }
  .skills { list-style: none; padding: 0; }
  .plain { list-style: none; padding: 0; }
  article { margin-top: 8px; break-inside: avoid-page; }
  article:first-of-type { margin-top: 0; }
  .role { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .period { color: #59636e; white-space: nowrap; }
  .org { color: #59636e; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  @media (max-width: 560px) { .two { grid-template-columns: 1fr; } }
</style>
