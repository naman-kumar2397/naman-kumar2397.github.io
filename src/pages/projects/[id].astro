---
import Base from '../../layouts/Base.astro';
import RepoHeader from '../../components/RepoHeader.astro';
import Diagram from '../../components/Diagram.astro';
import { caseStudies, type CaseStudy, type Feature } from '../../data/caseStudies';
import { branches, commits, type Branch } from '../../data/journey';
import { profile } from '../../data/profile';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const assets = import.meta.glob<{ default: ImageMetadata }>('../../assets/*.{png,jpg,jpeg,webp}', { eager: true });

export function getStaticPaths() {
  const featured = caseStudies.filter((c) => c.feature);
  return featured.map((c, i) => ({
    params: { id: c.id },
    props: { c, prev: featured[i - 1] ?? null, next: featured[i + 1] ?? null },
  }));
}

interface Props { c: CaseStudy & { feature: Feature }; prev: CaseStudy | null; next: CaseStudy | null }
const { c, prev, next } = Astro.props;
const f = c.feature;
const mediaImg = f.media ? assets[`../../assets/${f.media.file}`]?.default : undefined;
if (f.media && !mediaImg) throw new Error(`case study media not found: ${f.media.file}`);
const has = (v?: string | string[]) => !!v && (typeof v === 'string' || v.length > 0);
// Keep within ~160 characters so search results don't truncate it.
const base = `${c.title}: ${c.headline}.`;
const description = `${base} Case study by ${profile.name}, Lead SRE.`.length <= 160 ? `${base} Case study by ${profile.name}, Lead SRE.` : base.slice(0, 160);
const vtCss = caseStudies
  .filter((x) => x.feature)
  .map((x) => `::view-transition-group(cs-title-${x.id}){animation-duration:var(--dur-slow);animation-timing-function:var(--ease-out);}`)
  .join('');
const site = Astro.site!.toString();
const pageUrl = new URL(`/projects/${c.id}/`, site).toString();
const jsonLd = [
    {
      '@context': 'https://schema.org',
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: c.title,
      description,
      image: new URL(`/social/${c.id}.png`, site).toString(),
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Person', name: profile.name, url: site, jobTitle: profile.role },
      about: c.stack,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: profile.name, item: site },
        { '@type': 'ListItem', position: 2, name: 'Case studies', item: new URL('/#projects', site).toString() },
        { '@type': 'ListItem', position: 3, name: c.title, item: pageUrl },
      ],
    },
];
---
<Base title={`${c.title} | Case study | ${profile.name}`} description={description} jsonLd={jsonLd} ogType="article" ogImage={`/social/${c.id}.png`} ogImageAlt={`${c.title}: ${c.headline}`}>
  <a class="skip" href="#main">Skip to content</a>
  <RepoHeader commitCount={commits.length} projectCount={caseStudies.length} path={['projects', c.id]} current="Projects" />
  <main id="main" class="container cs">
    <style is:inline set:html={vtCss}></style>
    <p class="back" style="--d:0"><a href="/#projects">Back to all projects</a></p>

    <header class="cs-head">
      <div class="meta" style="--d:1">
        <span class={`state ${c.status === 'Shipped' ? 'merged' : 'open'}`}>{c.status}</span>
        <span class="muted">{c.context}</span>
      </div>
      <h1 style={`view-transition-name:cs-title-${c.id}`}>{c.title}</h1>
      <p class="headline" style="--d:2">{c.headline}</p>
      <p class="overview" style="--d:3">{c.overview}</p>
      {f.publicLink && <p class="public"><a href={f.publicLink.href} rel="noopener">{f.publicLink.label} <span aria-hidden="true">↗</span></a></p>}
    </header>


    <dl class="facts" style="--d:4">
      <div><dt>My role</dt><dd>{f.role}</dd></div>
      {f.facts.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
    </dl>

    {f.media && mediaImg && (
      <figure class="media">
        <Picture src={mediaImg} formats={['avif', 'webp']} widths={[480, 768, 1024]} sizes="(min-width: 1000px) 896px, 100vw" alt={f.media.alt} class="media-img" loading="lazy" />
        <figcaption>{f.media.caption && <span>{f.media.caption} </span>}<span class="credit">Image: <a href={f.media.href} rel="noopener">{f.media.credit}</a></span></figcaption>
      </figure>
    )}

    <section class="block" aria-labelledby="arch">
      <h2 id="arch" data-reveal="heading">Architecture</h2>
      <Diagram columns={f.diagram.columns} caption={f.diagram.caption} label={`${c.title} architecture, by stage`} />
    </section>

    {f.evolution && (
      <section class="block" aria-labelledby="evo">
        <h2 id="evo" data-reveal="heading">How it evolved</h2>
        <ol class="evo" data-reveal-group>
          {f.evolution.map((e) => (
            <li data-reveal="up">
              <h3>{e.phase}{e.when && <span class="when mono"> · {e.when}</span>}</h3>
              <ul>{e.points.map((x) => <li>{x}</li>)}</ul>
            </li>
          ))}
        </ol>
      </section>
    )}

    <div class="grid">
      {has(c.problem) && (
        <section class="block" aria-labelledby="problem" data-reveal="up"><h2 id="problem">Problem</h2><p>{c.problem}</p></section>
      )}
      <section class="block" aria-labelledby="contrib" data-reveal="up">
        <h2 id="contrib">My contribution</h2>
        <ul>{f.contributions.map((x) => <li>{x}</li>)}</ul>
      </section>
      {has(c.decisions) && (
        <section class="block" aria-labelledby="decisions" data-reveal="up"><h2 id="decisions">Engineering decisions</h2><ul>{c.decisions!.map((x) => <li>{x}</li>)}</ul></section>
      )}
      {has(f.tradeoffs) && (
        <section class="block" aria-labelledby="tradeoffs" data-reveal="up"><h2 id="tradeoffs">Trade-offs</h2><ul>{f.tradeoffs!.map((x) => <li>{x}</li>)}</ul></section>
      )}
      {has(c.reliability) && (
        <section class="block" aria-labelledby="rel" data-reveal="up"><h2 id="rel">Reliability and security</h2><ul>{c.reliability!.map((x) => <li>{x}</li>)}</ul></section>
      )}
      {has(c.outcomes) && (
        <section class="block outcomes" aria-labelledby="out" data-reveal="up"><h2 id="out">Verified outcomes</h2><ul>{c.outcomes!.map((x) => <li>{x}</li>)}</ul></section>
      )}
    </div>

    <section class="block" aria-labelledby="stack-h">
      <h2 id="stack-h" data-reveal="heading">Stack</h2>
      <ul class="stack">{c.stack.map((t) => <li class="topic">{t}</li>)}</ul>
    </section>

    <p class="note muted" data-reveal="fade">{f.confidentiality}</p>

    {c.branch && <p><a class="mono log-link" href={`/?branch=${c.branch}#journey`}>git log {(branches as Record<string, Branch>)[c.branch]?.name ?? c.branch}: see this in the career journey</a></p>}

    <aside class="cta" aria-labelledby="cta-h" data-reveal="card">
      <h2 id="cta-h">Want the details behind this?</h2>
      <p class="muted">Happy to walk through the architecture and decisions in a conversation.</p>
      <div class="ctas">
        <a class="btn btn-lg btn-primary" href={`mailto:${profile.email}`}>Email me<span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-lg" href="/resume.pdf" download="Naman_Kumar_Resume.pdf">Download resume (PDF)<span class="arrow arrow-d" aria-hidden="true">↓</span></a>
      </div>
    </aside>

    <nav class="pager" aria-label="More case studies" data-reveal="up">
      {prev ? <a href={`/projects/${prev.id}/`} rel="prev"><span class="muted"><span class="pa pa-l" aria-hidden="true">←</span>Previous</span>{prev.title}</a> : <span></span>}
      {next ? <a href={`/projects/${next.id}/`} rel="next" class="nx"><span class="muted">Next<span class="pa pa-r" aria-hidden="true">→</span></span>{next.title}</a> : <span></span>}
    </nav>
  </main>
  <footer class="container foot"><a href="/">naman-kumar2397.github.io</a></footer>
</Base>

<style>
  .skip { position: absolute; left: 8px; top: -48px; z-index: 30; background: var(--bg); padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; }
  .skip:focus { top: 8px; }
  .cs { max-width: 960px; padding-bottom: 24px; }
  .back { margin: 20px 0 0; font-size: 14px; }
  .back a { display: inline-flex; min-height: 32px; align-items: center; }
  .cs-head { margin-top: 12px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; font-size: 13px; }
  h1 { font-size: clamp(28px, 6vw, 40px); line-height: 1.15; letter-spacing: -0.02em; margin: 12px 0 0; font-weight: 650; }
  .headline { font-size: clamp(17px, 4vw, 20px); font-weight: 600; color: var(--accent); margin: 8px 0 0; }
  .overview { font-size: 16px; margin: 12px 0 0; max-width: 70ch; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); margin: 24px 0 0; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  /* Dividers drawn per cell (right and bottom edges), clipped by the rounded container, so a
     short last row never leaves empty grey filler cells. */
  .facts div { background: var(--panel); padding: 12px 14px; box-shadow: 1px 0 0 var(--border), 0 1px 0 var(--border); }
  .public { margin: 10px 0 0; font-size: 14px; }
  .public a { display: inline-flex; min-height: 32px; align-items: center; gap: 4px; }
  .media { margin: 24px 0 0; }
  :global(.media-img) { display: block; width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--border); background: var(--panel); }
  .media figcaption { font-size: 13px; color: var(--muted); margin-top: 8px; }
  .credit { white-space: nowrap; }
  .credit a, .media figcaption a { text-decoration: underline; text-underline-offset: 2px; }
  dt { font: 12px/1.5 var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  dd { margin: 2px 0 0; font-weight: 500; }
  .block { margin-top: 32px; }
  .block h2 { font-size: 20px; margin: 0 0 10px; font-weight: 600; }
  .block p { margin: 0; max-width: 70ch; }
  .block ul:not(.stack) { margin: 0; padding-left: 20px; }
  .block li { margin: 6px 0; }
  .grid { display: grid; gap: 0 40px; }
  .evo { list-style: none; margin: 0; padding: 0; }
  .evo > li { position: relative; padding: 0 0 16px 24px; }
  .evo > li::before { content: ''; position: absolute; left: 4px; top: 8px; bottom: -4px; width: 2px; background: var(--border); }
  .evo > li:last-child::before { display: none; }
  .evo > li::after { content: ''; position: absolute; left: 0; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .evo h3 { font-size: 16px; margin: 0 0 4px; font-weight: 600; }
  .evo .when { font-size: 13px; color: var(--muted); font-weight: 400; }
  .outcomes ul { list-style: none; padding: 0 !important; }
  .outcomes li { border-left: 3px solid var(--open-bg); padding: 4px 0 4px 12px; font-weight: 500; }
  .note { font-size: 13px; margin: 28px 0 0; padding: 10px 12px; border: 1px solid var(--border-muted); border-radius: 6px; background: var(--panel); }
  .log-link { font-size: 13px; display: inline-flex; min-height: 44px; align-items: center; }
  .cta { margin-top: 24px; border: 1px solid var(--border); border-radius: 8px; padding: 20px; box-shadow: var(--shadow); }
  .cta h2 { font-size: 20px; margin: 0; }
  .cta p { margin: 4px 0 0; }
  .ctas { display: grid; gap: 8px; margin-top: 14px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
  .pager a {
    display: grid; gap: 2px; border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; min-height: 44px; font-weight: 600;
    transition: transform var(--dur-normal) var(--ease-out), box-shadow var(--dur-normal) var(--ease-standard), border-color var(--dur-fast) var(--ease-standard);
  }
  .pager a:hover { text-decoration: none; border-color: var(--accent); }
  .pa { display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
  .pa-l { margin-right: 6px; }
  .pa-r { margin-left: 6px; }
  .btn .arrow { display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
  .btn:hover .arrow, .btn:focus-visible .arrow { transform: translateX(3px); }
  .btn:hover .arrow-d, .btn:focus-visible .arrow-d { transform: translateY(2px); }
  .cta { transition: box-shadow var(--dur-normal) var(--ease-standard), border-color var(--dur-normal) var(--ease-standard); }
  :global(html.motion) .cta[data-reveal] {
    transition:
      opacity var(--dur-reveal) var(--ease-out), translate var(--dur-reveal) var(--ease-out),
      scale var(--dur-reveal) var(--ease-out), filter var(--dur-reveal) var(--ease-out),
      box-shadow var(--dur-normal) var(--ease-standard), border-color var(--dur-normal) var(--ease-standard);
  }
  @media (hover: hover) and (pointer: fine) {
    .pager a:hover { transform: translateY(-2px); box-shadow: var(--shadow), 0 10px 24px -12px rgba(1, 4, 9, .28); }
    .pager a:hover .pa-l { transform: translateX(-3px); }
    .pager a:hover .pa-r { transform: translateX(3px); }
    .cta:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); box-shadow: var(--shadow), 0 14px 32px -14px rgba(1, 4, 9, .25); }
  }
  .pager a:focus-visible .pa-l { transform: translateX(-3px); }
  .pager a:focus-visible .pa-r { transform: translateX(3px); }

  /* Entrance on load (JS + motion allowed only). */
  @keyframes cs-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes cs-fade { from { opacity: 0; } to { opacity: 1; } }
  :global(html.motion) .back, :global(html.motion) .meta, :global(html.motion) .cs-head .headline,
  :global(html.motion) .cs-head .overview, :global(html.motion) .facts {
    animation: cs-in var(--dur-reveal) var(--ease-out) both;
    animation-delay: calc(var(--d, 0) * 60ms);
  }
  /* h1 only fades: its position morphs from the home-page card title (view transition). */
  :global(html.motion) h1 { animation: cs-fade var(--dur-normal) var(--ease-out) both; animation-delay: 60ms; }

  /* Evolution timeline dots scale in with their row. */
  :global(html.motion) .evo > li::after { scale: 0; transition: scale var(--dur-slow) var(--ease-out) 120ms; }
  :global(html.motion) .evo > li.is-in::after { scale: 1; }
  .pager span.muted { font-size: 12px; font-weight: 400; }
  .nx { text-align: right; }
  .foot { padding-top: 24px; padding-bottom: 40px; font-size: 13px; }
  @media (min-width: 560px) { .ctas { display: flex; flex-wrap: wrap; } }
  @media (min-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
