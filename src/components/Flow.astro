---
/* Accessible architecture flow: an ordered list styled as a diagram. */
import type { FlowStep } from '../data/caseStudies';
interface Props { steps: FlowStep[]; caption: string; label: string }
const { steps, caption, label } = Astro.props;
---
<figure class="flow-fig" data-inview>
  <ol class="flow" aria-label={label} data-reveal-group>
    {steps.map((s, i) => (
      <li class="step" data-reveal="scale" style={`--i:${i}`}>
        <span class="n mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="lbl">{s.label}</span>
        {s.detail && <span class="dt">{s.detail}</span>}
      </li>
    ))}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .flow-fig { margin: 0; --flow-hi: color-mix(in srgb, var(--accent) 70%, #fff); }
  @keyframes flow-v { 0% { background-position: 0 -100%, 0 0; } 60%, 100% { background-position: 0 200%, 0 0; } }
  @keyframes flow-h { 0% { background-position: -100% 0, 0 0; } 60%, 100% { background-position: 200% 0, 0 0; } }
  .flow { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .step {
    position: relative; display: grid; gap: 2px;
    border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px 10px 44px;
    background: var(--panel);
    transition: border-color var(--dur-normal) var(--ease-standard);
  }
  :global(html.motion) .step[data-reveal] {
    transition:
      opacity var(--dur-reveal) var(--ease-out),
      scale var(--dur-reveal) var(--ease-out),
      border-color var(--dur-normal) var(--ease-standard);
  }
  .n { position: absolute; left: 12px; top: 11px; font-size: 12px; color: var(--accent); }
  .lbl { font-weight: 600; font-size: 14px; line-height: 1.35; }
  .dt { font-size: 13px; color: var(--muted); line-height: 1.4; }
  /* connector */
  .step:not(:last-child)::after {
    content: ''; position: absolute; left: 22px; bottom: -22px; height: 22px; width: 2px;
    background:
      linear-gradient(transparent, var(--flow-hi), transparent) no-repeat 0 -100% / 100% 50%,
      linear-gradient(var(--border), var(--accent));
    animation: flow-v 2.8s var(--ease-in-out) infinite;
    animation-delay: calc(var(--i, 0) * 0.5s);
  }
  .flow-fig:not(.in-view) .step::after { animation-play-state: paused; }
  .step:not(:last-child)::before {
    content: ''; position: absolute; left: 18px; bottom: -22px; z-index: 1;
    border: 5px solid transparent; border-top-color: var(--accent); border-bottom: 0;
  }
  figcaption { font-size: 12px; color: var(--muted); margin-top: 8px; }
  @container case (min-width: 760px) {
    .flow { grid-template-columns: repeat(var(--steps, 4), minmax(0, 1fr)); gap: 24px; }
    .step { padding: 12px; align-content: start; }
    .n { position: static; }
    .step:not(:last-child)::after { left: auto; right: -24px; top: 50%; bottom: auto; width: 24px; height: 2px; animation-name: flow-h;
      background: linear-gradient(90deg, transparent, var(--flow-hi), transparent) no-repeat -100% 0 / 50% 100%, linear-gradient(90deg, var(--border), var(--accent)); }
    .step:not(:last-child)::before { left: auto; right: -24px; top: calc(50% - 5px); bottom: auto; border: 5px solid transparent; border-left-color: var(--accent); border-right: 0; }
  }
</style>
