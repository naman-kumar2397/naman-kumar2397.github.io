---
import { skills } from '../data/profile';
---
<section id="skills" class="container section" aria-labelledby="skills-title">
  <div class="section-head">
    <p class="kicker">cat skills.yml</p>
    <h2 id="skills-title">Skills</h2>
    <p>Grouped by capability, each backed by work described above.</p>
  </div>
  <ul class="grid">
    {skills.map((g) => (
      <li class="card">
        <h3>{g.group}</h3>
        <p class="ev">{g.evidence}</p>
        <p class="items">{g.items.join(' · ')}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .card { border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; background: var(--bg); }
  h3 { font-size: 15px; margin: 0; font-weight: 600; }
  .ev { font-size: 13px; color: var(--muted); margin: 4px 0 0; }
  .items { font: 13px/1.7 var(--mono); margin: 10px 0 0; }
</style>
