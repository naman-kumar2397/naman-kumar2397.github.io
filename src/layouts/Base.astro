---
import '../styles/global.css';
import { mdPath } from '../lib/markdown';
import { sitemapPaths } from '../lib/sitemap';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** JSON-LD object(s) for structured data. */
  /** JSON-LD object, or several (each rendered as its own script block). */
  jsonLd?: object | object[];
  /** Open Graph type: 'profile' for the home page, 'article' for case studies. */
  ogType?: 'profile' | 'article' | 'website';
  /** Social share image path (1200x630), defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title,
  description = 'Naman Kumar, Lead SRE in Melbourne: 7+ years running AWS at scale. Observability, infrastructure as code, incident automation and AI-assisted operations.',
  noindex = false,
  jsonLd,
  ogType = 'profile',
  ogImage: ogImagePath = '/og.png',
  ogImageAlt = 'Naman Kumar, Lead Site Reliability Engineer',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
// Indexable pages also have a Markdown version for AI assistants (src/lib/markdown.ts).
const markdown = sitemapPaths().includes(Astro.url.pathname) ? new URL(mdPath(Astro.url.pathname), Astro.site) : null;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown version" />}
    <meta name="author" content="Naman Kumar" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151b23" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Naman Kumar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="profile:first_name" content="Naman" />
    <meta property="profile:last_name" content="Kumar" />
    <meta name="twitter:card" content="summary_large_image" />
    {(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      // Enable entrance/reveal motion before first paint, unless reduced motion is requested.
      // Safety net: if the motion module never starts, drop the class so nothing stays hidden.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('motion'); }, 2500);
      }
    </script>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
