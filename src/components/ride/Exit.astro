---
/* The end of the ride on /home-alternate/: resume, contact and where to read more. */
import { profile } from '../../data/profile';
import { caseStudies } from '../../data/caseStudies';
const studies = caseStudies.filter((c) => c.feature);
---
<section id="contact" class="container exit" aria-labelledby="exit-title">
  <div class="card">
    <p class="kicker">git status</p>
    <h2 id="exit-title">That's HEAD.</h2>
    <p class="sub">Email is the fastest way to reach me. I'm based in {profile.location}.</p>
    <div class="ctas">
      <a class="btn btn-lg btn-primary" data-pointer href="/resume.pdf" download="Naman_Kumar_Resume.pdf">Download resume (PDF)</a>
      <a class="btn btn-lg" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn btn-lg" href={profile.linkedin} rel="noopener">LinkedIn</a>
    </div>
    <p class="more-h">Read more</p>
    <ul class="more">
      {studies.map((c) => <li><a href={`/projects/${c.id}/`}>{c.title}</a></li>)}
      <li><a href="/resume/">The resume on the web</a></li>
      <li><a href="/#journey">The full git log, for engineers</a></li>
    </ul>
  </div>
</section>

<style>
  .exit { padding-top: 72px; scroll-margin-top: var(--header-h); }
  .card {
    position: relative; overflow: hidden; border: 1px solid var(--border); border-radius: 14px; padding: 28px 20px;
    background: radial-gradient(600px circle at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%), var(--panel);
  }
  h2 { font-size: clamp(30px, 7vw, 48px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 650; margin: 0; }
  .sub { margin: 10px 0 0; color: var(--muted); font-size: 16px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .ctas .btn { overflow-wrap: anywhere; white-space: normal; }
  .more-h { margin: 24px 0 6px; font: 12px/1.5 var(--mono); color: var(--muted); }
  .more { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 14px; }
  .more a { display: inline-block; padding: 3px 0; }
  @media (min-width: 768px) {
    .exit { padding-top: 64px; }
    .card { padding: 40px 40px 36px; }
  }
</style>
