---
import { Picture } from 'astro:assets';
import photo from '../assets/profile.jpg';
import { profile } from '../data/profile';
import { branches } from '../data/journey';
---
<section id="top" class="hero" aria-labelledby="hero-name" data-inview data-pointer>
  <div class="ambient" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="glow"></span></div>
  <div class="container hero-in">
    <div class="copy">
      <p class="status">
        <span class="ref"><span class="live" aria-hidden="true"></span>HEAD -&gt; {branches.latitude.name}</span>
        <span class="muted">{profile.current.role} at {profile.current.employer}, for client {profile.current.client}</span>
      </p>
      <h1 id="hero-name">{profile.name.split(' ').map((w, i) => (<>{i > 0 && ' '}<span class="w"><span class="wi" style={`--i:${i}`}>{w}</span></span></>))}</h1>
      <p class="role">{profile.role} <span class="muted loc"><span class="dot" aria-hidden="true">· </span>{profile.location}</span></p>
      <p class="lead">{profile.headline}</p>
      <p class="pitch">{profile.pitch}</p>
      <div class="ctas">
        <a class="btn btn-lg btn-primary" data-pointer href="/resume.pdf" download="Naman_Kumar_Resume.pdf">Download resume (PDF)</a>
        <a class="btn btn-lg" href="#projects">Explore engineering projects</a>
        <a class="btn btn-lg" href="#contact">Contact me</a>
      </div>
    </div>
    <div class="photo-wrap" data-parallax="0.06">
    <Picture
      src={photo}
      formats={['avif', 'webp']}
      widths={[144, 288, 432]}
      sizes="(min-width: 900px) 216px, 80px"
      alt={`Portrait of ${profile.name}`}
      class="photo"
      loading="eager"
      fetchpriority="high"
    />
    </div>
  </div>
</section>

<style>
  .hero { border-bottom: 1px solid var(--border-muted); position: relative; overflow: hidden; isolation: isolate; }
  .hero-in { position: relative; z-index: 1; }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; padding-top: 24px; padding-bottom: 36px; }
  .copy { min-width: 0; }
  .status { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0 0 16px; font-size: 13px; }
  .ref {
    display: inline-flex; align-items: center; gap: 6px;
    font: 500 12px/20px var(--mono); color: #fff; background: #0969da;
    border-radius: 2em; padding: 0 8px; white-space: nowrap;
  }
  .live { position: relative; width: 6px; height: 6px; border-radius: 50%; background: #3fb950; flex: none; }
  .live::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid #3fb950; opacity: 0;
  }
  @media (prefers-color-scheme: dark) { .ref { background: #1f6feb; } }
  h1 { font-size: clamp(36px, 9vw, 56px); line-height: 1.05; letter-spacing: -0.025em; font-weight: 650; margin: 0; }
  .role { font-size: clamp(17px, 4.4vw, 20px); font-weight: 600; margin: 10px 0 0; color: var(--accent); }
  .role .muted { font-weight: 400; }
  @media (max-width: 559px) { .loc { display: block; font-size: 16px; margin-top: 2px; } .dot { display: none; } }
  .lead { font-size: clamp(20px, 5vw, 26px); line-height: 1.3; letter-spacing: -0.01em; font-weight: 500; margin: 20px 0 0; max-width: 36ch; text-wrap: balance; }
  .pitch { font-size: 16px; color: var(--muted); margin: 12px 0 0; max-width: 62ch; }
  .ctas { display: grid; gap: 8px; margin-top: 24px; }
  .photo-wrap { grid-row: 1; line-height: 0; translate: 0 var(--parallax, 0px); }
  :global(.photo) {
    width: 80px; height: 80px; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--border); box-shadow: var(--shadow); background: var(--panel);
  }
  @media (min-width: 560px) { .ctas { display: flex; flex-wrap: wrap; } }
  @media (min-width: 900px) {
    .hero-in { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 48px; padding-top: 56px; padding-bottom: 56px; }
    .photo-wrap { grid-row: auto; grid-column: 2; }
    :global(.photo) { width: 216px; height: 216px; }
  }

  /* Ambient layer: decorative, behind content. */
  .ambient { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; will-change: transform; }
  .b1 {
    width: 620px; height: 620px; top: -260px; right: -120px;
    background: radial-gradient(circle at center, color-mix(in srgb, var(--accent) 11%, transparent), transparent 68%);
  }
  .b2 {
    width: 560px; height: 560px; bottom: -280px; left: -140px;
    background: radial-gradient(circle at center, color-mix(in srgb, var(--c-teal) 9%, transparent), transparent 68%);
  }
  .glow { position: absolute; inset: 0; opacity: 0; display: none; }
  @media (hover: hover) and (pointer: fine) {
    .glow {
      display: block;
      background: radial-gradient(520px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 7%, transparent), transparent 65%);
      transition: opacity var(--dur-slow) var(--ease-standard);
    }
    .hero:hover .glow { opacity: 1; }
    .btn-primary { position: relative; overflow: hidden; isolation: isolate; }
    .btn-primary::after {
      content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; pointer-events: none;
      background: radial-gradient(120px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.18), transparent 70%);
      transition: opacity var(--dur-normal) var(--ease-standard);
    }
    .btn-primary:hover::after { opacity: 1; }
  }

  /* Entrance + continuous motion: only when JS is on and reduced motion is off. */
  :global(html.motion) .hero .live::after { animation: live-ring 2.4s var(--ease-out) infinite; animation-play-state: paused; }
  :global(html.motion) .hero.in-view .live::after { animation-play-state: running; }
  :global(html.motion) .blob { animation: drift-a 36s var(--ease-in-out) infinite alternate; animation-play-state: paused; }
  :global(html.motion) .b2 { animation-name: drift-b; animation-duration: 44s; }
  :global(html.motion) .hero.in-view .blob { animation-play-state: running; }
  :global(html.motion) .ambient { animation: hero-in var(--dur-hero) var(--ease-out) both; }

  :global(html.motion) .status { animation: hero-up var(--dur-reveal) var(--ease-out) 80ms both; }
  :global(html.motion) .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .12em; margin-bottom: -.12em; }
  :global(html.motion) .wi { display: inline-block; animation: word-up var(--dur-hero) var(--ease-out) calc(160ms + var(--i, 0) * 60ms) both; }
  :global(html.motion) .role { animation: hero-up var(--dur-reveal) var(--ease-out) 260ms both; }
  :global(html.motion) .lead { animation: hero-up var(--dur-reveal) var(--ease-out) 340ms both; }
  :global(html.motion) .pitch { animation: hero-up var(--dur-reveal) var(--ease-out) 420ms both; }
  :global(html.motion) .ctas { animation: hero-up var(--dur-reveal) var(--ease-out) 500ms both; }
  :global(html.motion) :global(.photo) { animation: hero-photo var(--dur-hero) var(--ease-out) 300ms both; }

  @keyframes hero-up {
    from { opacity: 0; transform: translateY(12px); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  @keyframes hero-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hero-photo {
    from { opacity: 0; transform: translateY(14px) scale(.97); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  @keyframes word-up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes live-ring {
    0% { transform: scale(1); opacity: .5; }
    70%, 100% { transform: scale(3.2); opacity: 0; }
  }
  @keyframes drift-a { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-60px, 40px, 0); } }
  @keyframes drift-b { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(70px, -30px, 0); } }
</style>
