---
import Base from '../layouts/Base.astro';
import RepoHeader from '../components/RepoHeader.astro';
import Hero from '../components/Hero.astro';
import Metrics from '../components/Metrics.astro';
import Experience from '../components/Experience.astro';
import CaseStudies from '../components/CaseStudies.astro';
import GitLog from '../components/GitLog.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { commits } from '../data/journey';
import { caseStudies } from '../data/caseStudies';
import { certification, profile } from '../data/profile';

const site = Astro.site!.toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: site,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.role,
    description: profile.pitch,
    url: site,
    email: `mailto:${profile.email}`,
    image: new URL('/og.png', site).toString(),
    address: { '@type': 'PostalAddress', addressLocality: 'Melbourne', addressRegion: 'VIC', addressCountry: 'AU' },
    worksFor: { '@type': 'Organization', name: 'Viable Solutions' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Manipal University Jaipur' },
    hasCredential: { '@type': 'EducationalOccupationalCredential', name: certification.split(' (')[0], credentialCategory: 'certification' },
    knowsAbout: ['Site Reliability Engineering', 'Amazon Web Services', 'Observability', 'Infrastructure as Code', 'Kubernetes', 'Incident management', 'AWS Bedrock'],
    sameAs: [profile.linkedin],
  },
};
---
<Base title="Naman Kumar | Lead Site Reliability Engineer, Melbourne" jsonLd={jsonLd}>
  <a class="skip" href="#main">Skip to content</a>
  <RepoHeader commitCount={commits.length} projectCount={caseStudies.length} />
  <main id="main">
    <Hero />
    <Metrics />
    <Experience />
    <CaseStudies />
    <Skills />
    <GitLog />
    <Contact />
  </main>
  <footer class="container foot">
    <p><span class="mono">HEAD</span> is where I am now. Built with Astro. Cookie-free, privacy-friendly visit counts (GoatCounter).</p>
    <p><a href="#top">Back to top</a></p>
  </footer>
</Base>

<style>
  .skip { position: absolute; left: 8px; top: -48px; z-index: 30; background: var(--bg); padding: 8px 12px; border: 1px solid var(--border); border-radius: 6px; }
  .skip:focus { top: 8px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-top: 32px; padding-bottom: 40px; font-size: 13px; color: var(--muted); }
  .foot p { margin: 0; }
  .foot a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    transition: background-size var(--dur-normal) var(--ease-standard);
  }
  .foot a:hover,
  .foot a:focus-visible {
    background-size: 100% 1px;
  }
</style>
