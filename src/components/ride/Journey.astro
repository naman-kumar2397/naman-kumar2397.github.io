---
/*
 * The journey: six chapters, newest first (content from src/lib/ride.ts, which picks it from
 * src/data). Server-rendered as stacked chapter cards with a chapter index, which is what
 * no-JS, reduced-motion and Save-Data visitors, crawlers and AI readers get.
 *
 * `.live` is added before first paint (html.motion and no Save-Data). Then, on desktop, the
 * rail and the particle stage are sticky beside the chapters and each chapter's text is
 * pinned through its one-screen scene while scrolling scrubs the field (src/scripts/ride.ts).
 * The copy is never hidden at any scroll position. On phones each card gets a small field.
 */
import { chapters } from '../../lib/ride';
const pad = (i: number) => String(i + 1).padStart(2, '0');
const total = pad(chapters.length - 1);
---
<section id="journey" class="journey" aria-labelledby="journey-title">
  <script is:inline>
    // Decide the cinematic layout before first paint: motion allowed and no Save-Data.
    (function () {
      var s = document.currentScript.parentElement, c = navigator.connection;
      if (document.documentElement.classList.contains('motion') && !(c && c.saveData)) s.classList.add('live');
    })();
  </script>
  <div class="container j-head">
    <p class="kicker">git log --first-parent HEAD</p>
    <h2 id="journey-title">The ride, from HEAD back to main</h2>
    <p class="j-sub">Six chapters, newest first. Scroll at your own pace, or use J and K to move between them.</p>
    <a class="skip-ride" href="#contact">Skip to resume</a>
  </div>

  <div class="j-grid">
    <nav class="rail" aria-label="Chapters">
      <div class="track" style={`--fill: linear-gradient(${chapters.map((c) => `var(--c-${c.colour})`).join(', ')})`}>
      <ol>
        {chapters.map((c) => (
          <li style={`--c: var(--c-${c.colour})`}>
            <a href={`#${c.id}`}>
              <span class="node" aria-hidden="true"></span>
              <span class="rl">{c.rail}</span>
              <span class="ry">{c.year}</span>
              <span class="head" aria-hidden="true">HEAD</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="rail-line" aria-hidden="true"><span class="rail-fill"></span></span>
      </div>
      <button type="button" class="pause" id="ride-pause" aria-pressed="false">Pause animation</button>
    </nav>

    <div class="chapters">
      {chapters.map((c, i) => (
        <article
          class="ch"
          id={c.id}
          aria-labelledby={`${c.id}-title`}
          style={`--c: var(--c-${c.colour})`}
          data-scene={c.scene}
          data-colour={c.colour}
          data-ref={c.ref}
        >
          <canvas class="ch-orb" aria-hidden="true"></canvas>
          <div class="ch-in">
            <p class="meta"><span class="n">{pad(i)} / {total}</span><span class="ref">{c.ref}</span></p>
            <p class="kick"><span class="k">{c.kicker}</span> {c.period}</p>
            <h2 id={`${c.id}-title`} tabindex="-1">{c.title}</h2>
            <p class="org">{c.org}</p>
            {c.figure && (
              <p class="fig">
                <span class="v" data-count={c.figure.count ? '' : undefined} style={`min-width: ${c.figure.value.length}ch`}>{c.figure.value}</span>
                <span class="l">{c.figure.label}</span>
              </p>
            )}
            <p class="out">{c.outcome}</p>
            <ul class="beats">{c.beats.map((b) => <li>{b}</li>)}</ul>
            <ul class="tags" aria-label="Stack">{c.tags.map((t) => <li class="chip">{t}</li>)}</ul>
            <a class="go" href={c.link.href}>{c.link.label}</a>
          </div>
        </article>
      ))}
    </div>

    <div class="stage" aria-hidden="true">
      <canvas class="field"></canvas>
      <span class="main-label">main</span>
      <span class="caption"><span class="cdot"></span><span class="cref">{chapters[0].ref}</span></span>
    </div>
  </div>
  <p class="sr-only" id="ride-status" aria-live="polite"></p>
</section>

<style>
  .journey { position: relative; padding-top: 48px; scroll-margin-top: var(--header-h); --cur: var(--accent); }
  .j-head { display: grid; gap: 6px; }
  .j-head h2 { font-size: clamp(26px, 6vw, 40px); line-height: 1.12; letter-spacing: -0.02em; font-weight: 650; margin: 0; }
  .j-sub { margin: 4px 0 0; color: var(--muted); max-width: 60ch; }
  .skip-ride { justify-self: start; font-size: 14px; padding: 6px 0; }

  /* ---- stacked layout (no JS, reduced motion, Save-Data, phones) ---- */
  .j-grid { max-width: 1120px; margin: 20px auto 0; padding: 0 16px; display: grid; gap: 16px; }
  .rail ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .rail a {
    display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 3px 10px 3px 8px;
    border: 1px solid var(--border); border-radius: 999px; color: var(--text); font-size: 13px; background: var(--bg);
  }
  .rail a:hover { text-decoration: none; border-color: var(--c); }
  .node { width: 9px; height: 9px; border-radius: 50%; background: var(--c); flex: none; }
  .ry { font: 12px/1 var(--mono); color: var(--muted); }
  .head { display: none; }
  .rail a[aria-current] { border-color: var(--c); background: color-mix(in srgb, var(--c) 10%, var(--bg)); }
  .track { position: relative; }
  .rail-line, .pause, .stage, .ch-orb { display: none; }
  .chapters { display: grid; gap: 14px; min-width: 0; }
  .ch { scroll-margin-top: calc(var(--header-h) + 12px); min-width: 0; }
  .ch-in {
    border: 1px solid var(--border); border-left: 3px solid var(--c); border-radius: 10px;
    padding: 18px 18px 20px; background: var(--bg); display: grid; gap: 10px; justify-items: start;
  }
  .meta { margin: 0; display: flex; gap: 10px; font: 12px/1.4 var(--mono); color: var(--muted); }
  .ref { color: var(--c); }
  .kick { margin: 0; font-size: 13px; color: var(--muted); }
  .kick .k { color: var(--c); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; font-size: 12px; margin-right: 4px; }
  .ch h2 { margin: 0; font-size: clamp(24px, 6vw, 32px); line-height: 1.15; letter-spacing: -0.02em; font-weight: 650; }
  .ch h2:focus { outline: none; }
  .ch h2:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .org { margin: -4px 0 0; color: var(--muted); font-size: 15px; }
  .fig { margin: 2px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; }
  .fig .v { font-size: clamp(40px, 11vw, 56px); line-height: 1; font-weight: 700; letter-spacing: -0.03em; color: var(--c); font-variant-numeric: tabular-nums; }
  .fig .l { font-size: 15px; color: var(--muted); }
  .out { margin: 0; font-size: 17px; line-height: 1.45; max-width: 46ch; text-wrap: pretty; }
  .beats { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; font-size: 14px; color: var(--muted); line-height: 1.45; }
  .beats li { position: relative; padding-left: 16px; }
  .beats li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 5px; height: 5px; border-radius: 50%; background: var(--c); opacity: .8; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 0; padding: 0; list-style: none; }
  .go {
    display: inline-block; font-weight: 500; font-size: 15px; padding: 2px 0; text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    transition: background-size var(--dur-normal) var(--ease-standard);
  }
  .go:hover, .go:focus-visible { background-size: 100% 1px; }

  @media (min-width: 768px) { .j-grid { padding: 0 32px; } }
  /* Stacked on wide screens: two columns of cards (the live layout overrides this below). */
  @media (min-width: 900px) { .chapters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ---- live, phones: a small field on top of each card ---- */
  @media (max-width: 899px) {
    :global(html.motion) .journey:global(.live) .pause { display: inline-flex; }
    :global(html.motion) .journey:global(.live) .ch-orb {
      display: block; width: 100%; height: 150px; border: 1px solid var(--border); border-bottom: 0;
      border-radius: 10px 10px 0 0; background: var(--panel);
    }
    :global(html.motion) .journey:global(.live) .ch-orb + .ch-in { border-top-left-radius: 0; border-top-right-radius: 0; }
    .rail { display: grid; gap: 10px; justify-items: start; }
  }
  .pause {
    font: 500 12px/1 var(--mono); color: var(--muted); background: transparent; cursor: pointer;
    border: 1px solid var(--border); border-radius: 999px; padding: 7px 11px; min-height: 28px; align-items: center;
  }
  .pause[aria-pressed='true'] { color: var(--text); border-color: var(--muted); }

  /* ---- live, desktop: sticky rail and stage, each chapter a pinned one-screen scene ---- */
  @media (min-width: 900px) {
    :global(html.motion) .journey:global(.live) .j-grid {
      max-width: 1320px; padding: 0 32px; margin-top: 8px;
      grid-template-columns: 150px minmax(0, 440px) minmax(0, 1fr); gap: 0 48px; align-items: start;
    }
    :global(html.motion) .journey:global(.live) .rail {
      position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h));
      display: grid; align-content: center; justify-items: start; gap: 28px;
    }
    :global(html.motion) .journey:global(.live) .rail ol { flex-direction: column; gap: 22px; position: relative; z-index: 1; }
    :global(html.motion) .journey:global(.live) .rail a {
      border: 0; background: none; padding: 2px 4px 2px 0; border-radius: 6px; gap: 12px; min-height: 28px;
      display: grid; grid-template-columns: 12px auto; grid-template-rows: auto auto; column-gap: 12px; row-gap: 0;
    }
    :global(html.motion) .journey:global(.live) .node {
      grid-row: 1 / 3; align-self: center; width: 12px; height: 12px; background: var(--bg);
      border: 2px solid var(--c); box-sizing: border-box; transition: background-color var(--dur-normal) var(--ease-standard), box-shadow var(--dur-normal) var(--ease-standard);
    }
    :global(html.motion) .journey:global(.live) .rl { font-size: 14px; color: var(--muted); transition: color var(--dur-normal) var(--ease-standard); }
    :global(html.motion) .journey:global(.live) .ry { font-size: 11px; }
    :global(html.motion) .journey:global(.live) .rail a:hover .rl { color: var(--text); }
    :global(html.motion) .journey:global(.live) .rail a[aria-current] { background: none; }
    :global(html.motion) .journey:global(.live) .rail a[aria-current] .node { background: var(--c); box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 22%, transparent); }
    :global(html.motion) .journey:global(.live) .rail a[aria-current] .rl { color: var(--text); font-weight: 600; }
    :global(html.motion) .journey:global(.live) .head {
      display: none; position: absolute; left: calc(100% + 6px); top: 50%; translate: 0 -50%;
      font: 600 10px/16px var(--mono); color: #fff; background: var(--c); border-radius: 2em; padding: 0 6px;
    }
    :global(html.motion) .journey:global(.live) .rail a { position: relative; }
    :global(html.motion) .journey:global(.live) .rail a[aria-current] .head { display: block; }
    /* The branch line behind the nodes, filling with progress. */
    :global(html.motion) .journey:global(.live) .rail-line {
      display: block; position: absolute; left: 5px; width: 2px; top: 16px; bottom: 16px;
      background: var(--border-muted); border-radius: 2px; overflow: hidden;
    }
    :global(html.motion) .journey:global(.live) .rail-fill {
      position: absolute; inset: 0; transform-origin: 50% 0; transform: scaleY(0);
      background: var(--fill);
    }
    :global(html.motion) .journey:global(.live) .pause { display: inline-flex; }
    :global(html.motion) .journey:global(.live) .chapters { gap: 0; grid-template-columns: minmax(0, 1fr); }
    :global(html.motion) .journey:global(.live) .ch { min-height: 96vh; scroll-margin-top: 0; }
    :global(html.motion) .journey:global(.live) .ch:last-child { min-height: 72vh; }
    :global(html.motion) .journey:global(.live) .ch-in {
      position: sticky; top: calc(var(--header-h) + 7vh);
      border: 0; border-radius: 0; padding: 8px 0 24px; background: none; gap: 12px;
    }
    :global(html.motion) .journey:global(.live) .ch h2 { font-size: clamp(30px, 3.1vw, 42px); }
    :global(html.motion) .journey:global(.live) .fig .v { font-size: clamp(52px, 5.4vw, 76px); }
    :global(html.motion) .journey:global(.live) .out { font-size: 18px; }
    :global(html.motion) .journey:global(.live) .stage {
      display: block; position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h));
      margin-right: -32px;
    }
    .stage canvas {
      position: absolute; inset: 0; width: 100%; height: 100%; display: block;
      /* Soft edges, so scenes that reach the side never end on a hard line. */
      mask-image: linear-gradient(to right, transparent, #000 10%, #000 92%, transparent);
    }
    .caption {
      position: absolute; left: 0; bottom: 28px; display: inline-flex; align-items: center; gap: 8px;
      font: 12px/1 var(--mono); color: var(--muted);
    }
    .cdot { width: 8px; height: 8px; border-radius: 50%; background: var(--cur); transition: background-color var(--dur-slow) var(--ease-standard); }
    /* "main": the point the last chapter collapses into (opacity driven by the script). */
    .main-label {
      position: absolute; left: 50%; top: 50%; translate: -50% 26px; opacity: var(--origin, 0);
      font: 600 13px/1 var(--mono); letter-spacing: .08em; color: var(--text);
    }
  }
  :global(html.motion) .journey:global(.live.paused) .cdot { opacity: .5; }
</style>

<script>
  import { initRide } from '../../scripts/ride';
  const root = document.getElementById('journey');
  if (root) initRide(root);
</script>
