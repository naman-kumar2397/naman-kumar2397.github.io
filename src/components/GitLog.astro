---
import { author, branches, commits, type Branch } from '../data/journey';
import { computeLayout } from '../lib/layout';
import type { GraphData } from './graph';

const layout = computeLayout(branches, commits);
const B = branches as Record<string, Branch>;
const rows = [...layout.rows].reverse(); // newest first, like git log
const branchCount = Object.keys(branches).length - 1;

// Company a row belongs to, for filtering: role branches, and projects via their parent.
const companyOf = (id: string): string | null => {
  const b = B[id];
  if (b.type === 'role') return id;
  if (b.type === 'project' && b.parent) return companyOf(b.parent);
  return null;
};
const companies = Object.entries(B).filter(([, b]) => b.type === 'role').map(([id, b]) => ({ id, label: b.label }));
const typeLabel = { trunk: '', education: 'education', role: 'role', project: 'project' } as const;
const highlightsCount = layout.rows.filter((r) => r.commit.kind !== 'commit' || r.commit.milestone || r.commit.tag).length;

const graphData: GraphData = {
  rows: layout.rows.map((r) => ({ lane: r.lane, owner: r.owner, colour: B[r.branch].colour, mergeColour: r.commit.kind === 'merge' ? B[r.owner].colour : undefined, kind: r.commit.kind, head: r.isHead, marker: r.commit.tag ? 'diamond' : 'dot' })),
  spans: Object.values(layout.spans).map((s) => ({
    branch: s.branch,
    colour: B[s.branch].colour,
    lane: s.lane,
    parentLane: B[s.branch].parent ? layout.spans[B[s.branch].parent!].lane : null,
    start: s.start,
    end: s.mergeRow ?? s.tip,
    merged: s.mergeRow !== null,
  })),
};
---
<section id="journey" class="container section" aria-labelledby="journey-title">
  <div class="section-head" data-reveal="heading">
    <p class="kicker">git log --graph --all</p>
    <h2 id="journey-title">Career journey</h2>
    <p>The full story, for the curious: my career as a git history. Each company is a branch off <code>main</code> that merged back when I moved on; projects branch off their company. Select any entry for details.</p>
  </div>
  <div class="box log-box" data-reveal="card">
  <div class="box-head">
    <span class="mono head-title" aria-hidden="true">~/naman-kumar/journey</span>
    <span class="sp"></span>
    <span class="muted counts" id="log-count">{commits.length} commits<span class="hide-xs"> · {branchCount} branches</span></span>
  </div>
  <div class="toolbar" id="log-toolbar" hidden>
    <div class="seg" role="group" aria-label="View">
      <span class="seg-thumb" aria-hidden="true"></span>
      <button type="button" data-view="highlights" aria-pressed="true">Highlights <span class="n">{highlightsCount}</span></button>
      <button type="button" data-view="full" aria-pressed="false">Full history <span class="n">{commits.length}</span></button>
    </div>
    <div class="filters">
      <label>
        <span class="sr-only">Filter by type</span>
        <select data-filter="type">
          <option value="">All types</option>
          <option value="role">Roles</option>
          <option value="project">Projects</option>
          <option value="recognition">Awards and certifications</option>
          <option value="education">Education</option>
        </select>
      </label>
      <label>
        <span class="sr-only">Filter by company</span>
        <select data-filter="company">
          <option value="">All companies</option>
          {companies.map((c) => <option value={c.id}>{c.label}</option>)}
        </select>
      </label>
    </div>
  </div>
  <p class="sr-only" id="log-status" aria-live="polite"></p>
  <div class="log-clip" id="log-clip">
  <div class="log-wrap" id="git-log" style={`--lanes:${layout.laneCount}`}>
    <svg class="graph" aria-hidden="true" focusable="false"></svg>
    <ol class="log">
      {rows.map((r) => {
        const c = r.commit;
        const own = B[r.owner];
        const onBranch = B[r.branch];
        const span = layout.spans[r.owner];
        const id = `c-${r.hash}`;
        return (
          <li
            class="row"
            data-row={r.index}
            data-owner={r.owner}
            data-kind={c.kind}
            data-type={c.tag ? 'recognition' : own.type}
            data-company={companyOf(r.owner) ?? ''}
            data-highlight={c.kind !== 'commit' || c.milestone || c.tag ? '1' : '0'}
            style={`--c:var(--c-${own.colour})`}
          >
            <button class="row-head" type="button" id={`${id}-h`} aria-expanded="false" aria-controls={`${id}-b`}>
              <span class="msg">
                <span class="t">{c.message}</span>
                {r.isHead && <span class="ref head">HEAD -&gt; {onBranch.name}</span>}
                {!r.isHead && c.kind === 'branch' && <span class="ref">{own.name}</span>}
              </span>
              <span class="meta">
                {c.tag && <span class="kind">{c.tag === 'cert' ? 'certification' : 'award'}</span>}
                {!c.tag && c.kind === 'branch' && typeLabel[own.type] && <span class="kind">{typeLabel[own.type]}</span>}
                <span class="hash">{r.hash}</span>
                {c.date && <span> · {c.date}</span>}
                <span> · {own.name}</span>
              </span>
            </button>
            <div class="row-body" id={`${id}-b`} aria-labelledby={`${id}-h`} hidden>
              <div class="body-in">
                {c.kind === 'branch' ? (
                  <article class="card">
                    <div class="card-head">
                      <span class="ref">{own.name}</span>
                      <span class={`state ${span.open ? 'open' : 'merged'}`}>{span.open ? 'Open' : 'Merged'}</span>
                    </div>
                    <h3 class="card-title">{own.title}</h3>
                    <p class="card-org muted">{own.org}{own.period && ` · ${own.period}`}</p>
                    {own.highlights && <ul class="card-list">{own.highlights.map((h) => <li>{h}</li>)}</ul>}
                    {own.stack && <ul class="topics" aria-label="Stack">{own.stack.map((t) => <li class="topic">{t}</li>)}</ul>}
                  </article>
                ) : (
                  <pre class="show"><span class="show-commit">commit {r.hash}</span>{r.isHead && <span class="show-ref"> (HEAD -&gt; {onBranch.name})</span>}{'\n'}{r.parentHashes.length > 1 && `Merge: ${r.parentHashes.join(' ')}\n`}{`Author: ${author.name} <${author.email}>\n`}{c.date && `Date:   ${c.date}\n`}{'\n'}{(c.body ?? c.message).split('\n').map((l) => `    ${l}`).join('\n')}</pre>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
  </div>
  <div class="expand" id="log-expand" hidden>
    <button type="button" class="btn btn-lg" aria-controls="log-clip" aria-expanded="false">Show the full career log</button>
  </div>
  <ul class="legend" aria-label="Legend">
    <li><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4.5" fill="var(--c-gray)" /></svg>Commit</li>
    <li><svg width="12" height="12" aria-hidden="true"><circle cx="6" cy="6" r="4" fill="none" stroke="var(--c-gray)" stroke-width="2" /></svg>Merge (moved on)</li>
    <li><svg width="12" height="12" aria-hidden="true"><path d="M6 0.8 11.2 6 6 11.2 0.8 6Z" fill="var(--c-gray)" /></svg>Award or certification</li>
    <li><span class="ref head">HEAD</span>Where I am now</li>
  </ul>
  </div>
  <script type="application/json" id="git-log-data" set:html={JSON.stringify(graphData)} />
</section>

<style>
  .section-head code { font: 13px var(--mono); background: var(--code-bg); border: 1px solid var(--border-muted); border-radius: 6px; padding: 1px 5px; }
  .head-title { font-size: 13px; font-weight: 400; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .toolbar { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .seg { display: inline-flex; position: relative; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: var(--btn-bg); }
  .seg button {
    position: relative; z-index: 1;
    font: 500 13px/1 var(--sans); color: var(--text); background: transparent;
    border: 0; padding: 0 12px; min-height: 36px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    transition: color var(--dur-normal) var(--ease-in-out);
  }
  .seg button + button { border-left: 1px solid var(--border); }
  .seg button[aria-pressed='true'] { color: var(--accent); font-weight: 600; }
  /* one thumb slides between the buttons: 1px-wide box scaled to the button width, moved with transform */
  .seg-thumb { position: absolute; left: 0; top: 0; bottom: 0; width: 1px; transform-origin: 0 0; transform: translateX(var(--thumb-x, 0px)) scaleX(var(--thumb-w, 0)); background: var(--bg); box-shadow: inset 0 -2px 0 var(--tab-active); pointer-events: none; opacity: 0; }
  .seg.ready .seg-thumb { opacity: 1; transition: transform var(--dur-normal) var(--ease-in-out); }
  /* no-JS-measure fallback keeps the old look */
  .seg:not(.ready) button[aria-pressed='true'] { background: var(--bg); box-shadow: inset 0 -2px 0 var(--tab-active); }
  .seg .n { font-size: 12px; color: var(--muted); }
  .seg button:focus-visible { outline-offset: -3px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  select {
    font: 13px var(--sans); color: var(--text); background: var(--btn-bg);
    border: 1px solid var(--border); border-radius: 6px; min-height: 36px; padding: 0 8px; max-width: 100%;
  }
  .legend { list-style: none; margin: 0; padding: 10px 16px; display: flex; flex-wrap: wrap; gap: 6px 16px; border-top: 1px solid var(--border); font-size: 12px; color: var(--muted); background: var(--panel); border-radius: 0 0 6px 6px; }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .legend .ref.head { font-size: 10px; line-height: 16px; padding: 0 6px; }
  .kind { font: 11px/16px var(--mono); color: var(--c); border: 1px solid var(--border); border-radius: 4px; padding: 0 4px; margin-right: 6px; }
  .toolbar[hidden], .expand[hidden] { display: none; }
  .log-clip.collapsed { max-height: 520px; overflow: hidden; position: relative; }
  .log-clip.collapsed::after { content: ''; position: absolute; inset: auto 0 0 0; height: 96px; background: linear-gradient(transparent, var(--bg)); pointer-events: none; z-index: 2; }
  .seg.ready.snap .seg-thumb { transition: none; }
  .expand { display: flex; justify-content: center; padding: 12px; border-top: 1px solid var(--border-muted); }
  .row-head { transition: opacity var(--dur-fast) var(--ease-standard); }
  .row.faded > .row-head { opacity: .6; }
  .row.faded:hover > .row-head, .row.faded > .row-head:focus-visible { opacity: 1; }
  .counts { white-space: nowrap; }
  @media (max-width: 479px) { .hide-xs { display: none; } }
  .log-wrap {
    --x0: 14px;
    --lane-w: 16px;
    --gutter: calc(var(--x0) + (var(--lanes) - 1) * var(--lane-w) + 18px);
    position: relative;
  }
  .graph { position: absolute; left: 0; top: 0; width: var(--gutter); height: 100%; pointer-events: none; overflow: visible; z-index: 1; }
  .log { list-style: none; margin: 0; padding: 0; }
  .row { border-bottom: 1px solid var(--border-muted); position: relative; transition: background-color var(--dur-fast) var(--ease-standard), box-shadow var(--dur-fast) var(--ease-standard); }
  .row:last-child { border-bottom: 0; }
  .row:hover, .row:has(> .row-head[aria-expanded='true']) { background: var(--hover); }
  .row:has(> .row-head[aria-expanded='true']) { box-shadow: inset 2px 0 0 var(--c); }

  .row-head {
    display: flex; flex-direction: column; justify-content: center;
    width: 100%; min-height: 56px;
    padding: 8px 12px 8px var(--gutter);
    background: none; border: 0; color: inherit; font: inherit; text-align: left; cursor: pointer;
  }
  .row-head:focus-visible { outline-offset: -2px; border-radius: 0; }
  .msg { display: flex; align-items: center; gap: 8px; min-width: 0; width: 100%; }
  .t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; min-width: 0; }
  .meta { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .hash { font-family: var(--mono); }

  .ref {
    font: 500 11px/18px var(--mono);
    color: var(--c);
    border: 1px solid currentColor;
    border-radius: 2em;
    padding: 0 7px;
    white-space: nowrap;
    flex: none;
  }
  .msg .ref:not(.head) { display: none; }
  .ref.head { background: var(--accent); border-color: var(--accent); color: #fff; }
  @media (prefers-color-scheme: dark) { .ref.head { background: #1f6feb; border-color: #1f6feb; } }

  .row-body { overflow: hidden; }
  .body-in { padding: 0 12px 16px var(--gutter); }

  .card { border: 1px solid var(--border); border-radius: 6px; background: var(--bg); padding: 12px 16px 16px; }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .card-head .ref { white-space: normal; overflow-wrap: anywhere; }
  .card-title { font-size: 16px; font-weight: 600; margin: 10px 0 0; }
  .card-org { margin: 2px 0 0; font-size: 13px; }
  .card-list { padding-left: 20px; margin: 10px 0 0; }
  .card-list li { margin: 4px 0; }

  .show {
    margin: 0;
    padding: 12px 14px;
    font: 12px/1.6 var(--mono);
    color: var(--text);
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .show-commit { color: var(--c-yellow); }
  .show-ref { color: var(--c-teal); }

  @media (min-width: 640px) {
    .msg .ref:not(.head) { display: inline; }
    .log-wrap { --x0: 20px; --lane-w: 22px; }
    .row-head { padding-right: 16px; }
    .body-in { padding-right: 16px; }
  }

  /* graph elements are created at runtime */
  .graph :global(.lane) { fill: none; stroke-width: 2.5; stroke-linecap: round; transition: opacity var(--dur-fast) var(--ease-standard); }
  .graph :global(.node) { transition: opacity var(--dur-fast) var(--ease-standard); transform-box: fill-box; transform-origin: center; }
  .graph :global(.pulse) { fill: none; stroke-width: 2; transform-box: fill-box; transform-origin: center; }
  /* short cross-fade when the filter or view changes; only the log container is named */
  .log-clip.vt { view-transition-name: git-log; }
  :global(::view-transition-group(git-log)) { animation-duration: var(--dur-normal); animation-timing-function: var(--ease-standard); }
  :global(::view-transition-old(git-log)), :global(::view-transition-new(git-log)) { height: 100%; width: 100%; object-fit: none; object-position: left top; animation-duration: var(--dur-normal); animation-timing-function: var(--ease-standard); }
  .graph:global(.dim) :global(.lane:not(.hl)),
  .graph:global(.dim) :global(.node:not(.hl)),
  .graph:global(.dim) :global(.pulse:not(.hl)) { opacity: .2; }
</style>

<script>
  import { initGraph } from './graph';
  import { DURATION, prefersReducedMotion } from '../scripts/motion';
  const root = document.getElementById('git-log');
  const data = document.getElementById('git-log-data');
  const toolbar = document.getElementById('log-toolbar');
  if (root && data && toolbar) {
    const graph = initGraph(root, JSON.parse(data.textContent || '{}'));
    const rows = [...root.querySelectorAll<HTMLLIElement>('li.row')];
    const status = document.getElementById('log-status')!;
    const count = document.getElementById('log-count')!;
    const viewBtns = [...toolbar.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const typeSel = toolbar.querySelector<HTMLSelectElement>('[data-filter="type"]')!;
    const companySel = toolbar.querySelector<HTMLSelectElement>('[data-filter="company"]')!;
    let view: 'highlights' | 'full' = 'highlights';

    // Without JS the full history renders; the curated view is progressive enhancement.
    toolbar.hidden = false;

    // The log is secondary: show a preview until the visitor asks for more.
    const clip = document.getElementById('log-clip')!;
    const expand = document.getElementById('log-expand')!;
    const expandBtn = expand.querySelector('button')!;
    let expanding = false;
    let clipAnims: Animation[] = [];
    const setExpanded = (open: boolean) => {
      clipAnims.forEach((a) => a.cancel());
      clipAnims = [];
      expanding = false;
      clip.classList.toggle('collapsed', !open);
      expand.hidden = open;
      expandBtn.setAttribute('aria-expanded', String(open));
    };
    setExpanded(false);
    // Animate the clip from its collapsed height to full height, fading the gradient overlay, then drop the class.
    const expandAnimated = () => {
      if (expanding) return;
      const from = clip.offsetHeight;
      const to = Math.ceil(clip.scrollHeight);
      if (prefersReducedMotion() || typeof clip.animate !== 'function' || to <= from + 8) {
        setExpanded(true);
        return;
      }
      expanding = true;
      expandBtn.setAttribute('aria-expanded', 'true');
      const opts = { duration: DURATION.slow, easing: 'cubic-bezier(.65,0,.35,1)', fill: 'forwards' as FillMode };
      const grow = clip.animate([{ maxHeight: `${from}px` }, { maxHeight: `${to}px` }], opts);
      clipAnims = [grow];
      try {
        clipAnims.push(clip.animate([{ opacity: 1 }, { opacity: 0 }], { ...opts, pseudoElement: '::after' }));
      } catch { /* pseudo-element animations unsupported: overlay just disappears at the end */ }
      grow.finished.then(
        () => {
          if (!expanding) return;
          setExpanded(true);
          focusFirstHidden();
        },
        () => {},
      );
    };
    // Move focus to the first entry that was hidden behind the fade.
    const focusFirstHidden = () => {
      const firstHidden = rows.find((r) => !r.hidden && r.offsetTop > 400);
      firstHidden?.querySelector<HTMLButtonElement>('.row-head')?.focus();
    };
    // Keyboard users tabbing past the preview get the full log instead of focus vanishing under the fade.
    clip.addEventListener('focusin', (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>('li.row');
      if (clip.classList.contains('collapsed') && li && li.offsetTop + li.offsetHeight > clip.clientHeight - 96) setExpanded(true);
    });
    expandBtn.addEventListener('click', expandAnimated);

    // Segmented control: one thumb slides under the active button.
    const seg = toolbar.querySelector<HTMLElement>('.seg')!;
    const placeThumb = (animate: boolean) => {
      const active = viewBtns.find((b) => b.getAttribute('aria-pressed') === 'true');
      if (!active || !active.offsetWidth) return;
      if (!animate) seg.classList.add('snap');
      seg.style.setProperty('--thumb-x', `${active.offsetLeft}px`);
      seg.style.setProperty('--thumb-w', String(active.offsetWidth));
      seg.classList.add('ready');
      if (!animate) {
        void seg.offsetWidth; // commit the snap before transitions come back
        seg.classList.remove('snap');
      }
    };

    function applyNow() {
      const type = typeSel.value;
      const company = companySel.value;
      const filtering = !!(type || company);
      const matched = new Set<string>();
      let shown = 0;
      for (const li of rows) {
        const d = li.dataset;
        const matches = (!type || d.type === type) && (!company || d.company === company);
        // Branch and merge rows hold the graph together, so they fade instead of disappearing.
        const structural = d.kind !== 'commit';
        const inView = view === 'full' || d.highlight === '1';
        const visible = (inView || (filtering && matches)) && (matches || structural);
        li.hidden = !visible;
        li.classList.toggle('faded', visible && filtering && !matches);
        if (visible) shown++;
        if (filtering && matches) matched.add(d.owner!);
      }
      graph.setFocus(filtering ? matched : null);
      graph.refresh();
      const text = `Showing ${shown} of ${rows.length} commits`;
      count.textContent = text;
      status.textContent = text;
    }

    // Filter/view changes: cross-fade the log through a short view transition when available,
    // otherwise fade in only the rows that newly appear. The very first apply is always plain.
    type VT = { finished: Promise<unknown> };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => VT };
    function apply(animate = true) {
      if (!animate || prefersReducedMotion()) return applyNow();
      if (typeof doc.startViewTransition === 'function') {
        clip.classList.add('vt');
        const done = () => clip.classList.remove('vt');
        try {
          const vt = doc.startViewTransition(() => applyNow());
          vt.finished.then(done, done);
        } catch {
          done();
          applyNow();
        }
        return;
      }
      const before = new Map(rows.map((li) => [li, li.hidden]));
      applyNow();
      for (const li of rows) {
        if (before.get(li) && !li.hidden) {
          li.animate([{ opacity: 0 }, { opacity: 1 }], { duration: DURATION.fast, easing: 'cubic-bezier(.2,0,0,1)' });
        }
      }
    }

    viewBtns.forEach((b) =>
      b.addEventListener('click', () => {
        view = b.dataset.view as typeof view;
        viewBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        placeThumb(true);
        apply();
      }),
    );
    typeSel.addEventListener('change', () => apply());
    companySel.addEventListener('change', () => apply());
    apply(false);
    placeThumb(false);
    new ResizeObserver(() => placeThumb(false)).observe(seg);

    // "git log <branch>" links (case studies, project pages via ?branch=): open that branch's first commit.
    const reveal = (branch: string, smooth: boolean) => {
      const li = rows.find((r) => r.dataset.owner === branch && r.dataset.kind === 'branch');
      if (!li) return false;
      typeSel.value = '';
      companySel.value = '';
      setExpanded(true);
      apply(false);
      const btn = li.querySelector<HTMLButtonElement>('.row-head')!;
      if (btn.getAttribute('aria-expanded') !== 'true') btn.click();
      btn.focus({ preventScroll: true });
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      btn.scrollIntoView({ block: 'center', behavior: smooth && !reduce ? 'smooth' : 'auto' });
      return true;
    };
    document.querySelectorAll<HTMLAnchorElement>('a[data-branch]').forEach((a) =>
      a.addEventListener('click', (e) => {
        if (reveal(a.dataset.branch!, true)) e.preventDefault();
      }),
    );
    const wanted = new URLSearchParams(location.search).get('branch');
    if (wanted) requestAnimationFrame(() => reveal(wanted, false));
  }
</script>
