---
/*
 * Hero of /home-alternate/: the five-second version. Status, name, role, headline, five
 * keyword facts and the resume button all fit the first screen at 390x844. The portrait
 * entrance is the home page's (src/scripts/portrait.ts) with the same gate, decided before
 * first paint; the photo is 120px on phones.
 */
import { Picture } from 'astro:assets';
import PortraitFx from '../PortraitFx.astro';
import photo from '../../assets/profile.jpg';
import { profile } from '../../data/profile';
import { branches } from '../../data/journey';
import { heroFacts } from '../../lib/ride';

// Emphasise the leading figure of a fact ("50k+ concurrent users" -> <b>50k+</b> ...).
const split = (s: string) => {
  const m = s.match(/^(.*?)(~?\d[\d.,]*[kKM]?\+?)(.*)$/);
  return m ? m.slice(1) : ['', '', s];
};
---
<section id="top" class="hero" aria-labelledby="hero-name" data-inview data-pointer>
  <div class="ambient" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span></div>
  <div class="container hero-in">
    <p class="status">
      <span class="ref"><span class="live" aria-hidden="true"></span>HEAD -&gt; {branches.latitude.name}</span>
      <span class="muted">{profile.current.role} at {profile.current.employer}, for {profile.current.client}</span>
    </p>
    <div class="id">
      <h1 id="hero-name">{profile.name.split(' ').map((w, i) => (<>{i > 0 && ' '}<span class="w"><span class="wi" style={`--i:${i}`}>{w}</span></span></>))}</h1>
      <p class="role">{profile.role}<span class="loc"><span class="dot" aria-hidden="true"> · </span>{profile.location}</span></p>
    </div>
    <div class="photo-wrap">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[120, 240, 480]}
        sizes="(min-width: 900px) 240px, 120px"
        alt={`Portrait of ${profile.name}`}
        class="photo"
        loading="eager"
        fetchpriority="high"
      />
      <canvas class="portrait-fx" aria-hidden="true"></canvas>
    </div>
    <script is:inline>
      // Same gate as the home page hero (src/scripts/portrait.ts): motion allowed, no Save-Data,
      // desktop layout. A safety timeout always reveals the photo.
      (function () {
        var w = document.currentScript.previousElementSibling, c = navigator.connection;
        if (!document.documentElement.classList.contains('motion') || (c && c.saveData) || !matchMedia('(min-width: 900px)').matches) return;
        w.classList.add('fx');
        setTimeout(function () { w.classList.add('resolved'); }, 4000);
      })();
    </script>
    <p class="lead">{profile.headline}</p>
    <ul class="facts" aria-label="Key facts">
      {heroFacts.map((f) => { const [a, b, c] = split(f); return <li>{a}<b>{b}</b>{c}</li>; })}
    </ul>
    <div class="ctas">
      <a class="btn btn-lg btn-primary" data-pointer href="/resume.pdf" download="Naman_Kumar_Resume.pdf">Download resume (PDF)</a>
      <a class="btn btn-lg ride-btn" href="#journey">Take this ride with me</a>
      <a class="contact" href="#contact">Contact</a>
    </div>
  </div>
  <span class="cue" aria-hidden="true"><span></span></span>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--border-muted); }
  .hero-in {
    position: relative; z-index: 1; display: grid; gap: 0 16px;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'status status' 'id photo' 'lead lead' 'facts facts' 'ctas ctas';
    padding-top: 20px; padding-bottom: 40px;
  }
  .status { grid-area: status; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0 0 14px; font-size: 13px; }
  .ref {
    display: inline-flex; align-items: center; gap: 6px;
    font: 500 12px/20px var(--mono); color: #fff; background: #0969da;
    border-radius: 2em; padding: 0 8px; white-space: nowrap;
  }
  @media (prefers-color-scheme: dark) { .ref { background: #1f6feb; } }
  .live { position: relative; width: 6px; height: 6px; border-radius: 50%; background: #3fb950; flex: none; }
  .live::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 1px solid #3fb950; opacity: 0; }
  .id { grid-area: id; align-self: center; min-width: 0; }
  h1 { font-size: clamp(38px, 10.5vw, 76px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 650; margin: 0; }
  .role { font-size: clamp(16px, 4.2vw, 21px); font-weight: 600; margin: 10px 0 0; color: var(--accent); }
  .loc { color: var(--muted); font-weight: 400; }
  @media (max-width: 559px) { .loc { display: block; font-size: 15px; margin-top: 2px; } .dot { display: none; } }
  .lead { grid-area: lead; font-size: clamp(19px, 4.8vw, 28px); line-height: 1.3; letter-spacing: -0.012em; font-weight: 500; margin: 18px 0 0; max-width: 34ch; text-wrap: balance; }
  .facts { grid-area: facts; display: flex; flex-wrap: wrap; gap: 6px; margin: 16px 0 0; padding: 0; list-style: none; max-width: 760px; }
  .facts li {
    font-size: 13px; line-height: 20px; padding: 3px 10px; border-radius: 999px; color: var(--muted);
    background: color-mix(in srgb, var(--panel) 80%, transparent); border: 1px solid var(--border);
  }
  .facts b { color: var(--text); font-weight: 650; font-variant-numeric: tabular-nums; }
  .ctas { grid-area: ctas; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 20px; align-items: center; }
  .ctas .btn-primary { grid-column: 1 / -1; }
  .ride-btn { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .contact { justify-self: center; padding: 10px 6px; font-weight: 500; }
  .photo-wrap { grid-area: photo; align-self: center; line-height: 0; position: relative; }
  .portrait-fx { display: none; }
  :global(.photo) {
    width: 120px; height: 120px; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--border); box-shadow: var(--shadow); background: var(--panel);
  }
  .cue { display: none; }
  @media (min-width: 560px) {
    .ctas { display: flex; flex-wrap: wrap; gap: 8px 10px; }
    .contact { padding: 10px 8px; }
  }
  @media (min-width: 900px) {
    /* The first screen, minus the repo header (about 101px). */
    .hero { min-height: calc(100svh - 101px); display: grid; align-content: center; }
    .hero-in {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'status photo' 'id photo' 'lead photo' 'facts photo' 'ctas photo';
      gap: 0 64px; padding-top: 48px; padding-bottom: 72px; max-width: 1200px;
    }
    .status { margin-bottom: 20px; }
    .facts { margin-top: 24px; gap: 8px; }
    .facts li { font-size: 14px; padding: 5px 12px; }
    .ctas { margin-top: 30px; }
    .photo-wrap { align-self: center; }
    :global(.photo) { width: 240px; height: 240px; }
    /* Portrait entrance: canvas larger than the photo to hold the orbiting ring (see Hero.astro). */
    .portrait-fx {
      display: block; position: absolute; left: 50%; top: 50%; width: 286px; height: 286px;
      transform: translate(-50%, -50%); pointer-events: none; opacity: 0;
      transition: opacity var(--dur-fast) var(--ease-standard);
    }
    .portrait-fx:global(.on) { opacity: 1; }
    :global(html.motion) .photo-wrap:global(.fx) :global(.photo) { animation: none; opacity: 0; transition: opacity 500ms var(--ease-standard); }
    :global(html.motion) .photo-wrap:global(.fx.resolved) :global(.photo) { opacity: 1; }
    /* Scroll cue: a thin line with a travelling highlight, under the fold line. */
    :global(html.motion) .cue { display: block; position: absolute; left: 50%; bottom: 20px; width: 1px; height: 44px; background: var(--border); overflow: hidden; }
    .cue span { position: absolute; left: 0; top: 0; width: 1px; height: 14px; background: var(--accent); }
  }

  .ambient { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .blob { position: absolute; border-radius: 50%; }
  .b1 { width: 720px; height: 720px; top: -300px; right: -160px; background: radial-gradient(circle at center, color-mix(in srgb, var(--accent) 12%, transparent), transparent 68%); }
  .b2 { width: 620px; height: 620px; bottom: -320px; left: -160px; background: radial-gradient(circle at center, color-mix(in srgb, var(--c-teal) 10%, transparent), transparent 68%); }

  /* Entrance and ambient motion: JS on and reduced motion off only. */
  :global(html.motion) .hero .live::after { animation: live-ring 2.4s var(--ease-out) infinite; animation-play-state: paused; }
  :global(html.motion) .hero.in-view .live::after { animation-play-state: running; }
  :global(html.motion) .blob { animation: drift-a 36s var(--ease-in-out) infinite alternate; animation-play-state: paused; }
  :global(html.motion) .b2 { animation-name: drift-b; animation-duration: 44s; }
  :global(html.motion) .hero.in-view .blob { animation-play-state: running; }
  :global(html.motion) .status { animation: hero-up var(--dur-reveal) var(--ease-out) 80ms both; }
  :global(html.motion) .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .12em; margin-bottom: -.12em; }
  :global(html.motion) .wi { display: inline-block; animation: word-up var(--dur-hero) var(--ease-out) calc(160ms + var(--i, 0) * 60ms) both; }
  :global(html.motion) .role { animation: hero-up var(--dur-reveal) var(--ease-out) 260ms both; }
  :global(html.motion) .lead { animation: hero-up var(--dur-reveal) var(--ease-out) 340ms both; }
  :global(html.motion) .facts li { animation: hero-up var(--dur-reveal) var(--ease-out) both; }
  :global(html.motion) .facts li:nth-child(1) { animation-delay: 400ms; }
  :global(html.motion) .facts li:nth-child(2) { animation-delay: 440ms; }
  :global(html.motion) .facts li:nth-child(3) { animation-delay: 480ms; }
  :global(html.motion) .facts li:nth-child(4) { animation-delay: 520ms; }
  :global(html.motion) .facts li:nth-child(5) { animation-delay: 560ms; }
  :global(html.motion) .ctas { animation: hero-up var(--dur-reveal) var(--ease-out) 600ms both; }
  :global(html.motion) :global(.photo) { animation: hero-photo var(--dur-hero) var(--ease-out) 300ms both; }
  :global(html.motion) .hero.in-view .cue span { animation: cue 2.2s var(--ease-in-out) 1.2s infinite; }

  @keyframes hero-up { from { opacity: 0; transform: translateY(12px); filter: blur(4px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @keyframes hero-photo { from { opacity: 0; transform: translateY(14px) scale(.97); filter: blur(6px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @keyframes word-up { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes live-ring { 0% { transform: scale(1); opacity: .5; } 70%, 100% { transform: scale(3.2); opacity: 0; } }
  @keyframes drift-a { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(-60px, 40px, 0); } }
  @keyframes drift-b { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(70px, -30px, 0); } }
  @keyframes cue { from { transform: translateY(-14px); } to { transform: translateY(44px); } }
</style>

<PortraitFx />
